# Copy to .env.local. With no feed URL or bundled file, the app shows samples.

# Hosted feed URL; takes precedence over data/profiles.json. See docs/FEED.md.
PUBLISHED_SNAPSHOT_URL=

# Optional vector basemap key, exposed to the browser. Restrict allowed origins.
# Unset uses OpenStreetMap raster tiles.
NEXT_PUBLIC_PROTOMAPS_KEY=

# Optional Google Analytics measurement ID. Unset disables Google Analytics.
NEXT_PUBLIC_GA_ID=
